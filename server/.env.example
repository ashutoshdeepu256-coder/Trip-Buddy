NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/tripbuddy
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
VERIFICATION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ALLOW_DEV_VERIFICATION_CODES=false

# Optional HTTPS webhook destinations. They receive verification credentials to deliver.
EMAIL_PROVIDER_WEBHOOK_URL=
EMAIL_PROVIDER_API_KEY=
PHONE_OTP_PROVIDER_WEBHOOK_URL=
PHONE_OTP_PROVIDER_API_KEY=

# Required only for private identity document uploads.
CLOUDINARY_URL=